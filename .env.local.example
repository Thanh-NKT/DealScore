# ============================================================================
# Supabase — lấy từ Supabase Dashboard > Project Settings > API
# ============================================================================

# URL project (an toàn để lộ ra client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key (an toàn để lộ ra client — RLS bảo vệ dữ liệu)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — CHỈ dùng ở server (collector, cron, admin).
# TUYỆT ĐỐI không prefix NEXT_PUBLIC_ và không dùng ở client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Tra cứu URL (1.1.a)
# ============================================================================

# Salt để hash IP cho rate limit. BẮT BUỘC ở production (thiếu thì /api/lookup lỗi).
LOOKUP_IP_SALT=chuoi-ngau-nhien-dai

# Trần ingest sản phẩm mới toàn hệ thống mỗi ngày (bảo vệ quota Shopee API).
# LOOKUP_DAILY_INGEST_CAP=2000

# Chỉ ở dev: dùng dữ liệu Shopee giả lập khi chưa có Open API. Bị bỏ qua ở production.
# Không đặt thì dán URL chưa có trong catalog sẽ báo "Chưa lấy được dữ liệu từ Shopee".
# SHOPEE_CLIENT=fake

# ============================================================================
# 1.6 Tài khoản
# ============================================================================

# URL gốc của site, dùng cho link trong email. Thiếu ở production → báo lỗi.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Resend — thiếu ở dev thì email ứng dụng được in ra console; thiếu ở production thì báo lỗi.
# RESEND_API_KEY=re_xxx
EMAIL_FROM="Kairo <thong-bao@kairo.vn>"

# Bảo vệ /api/cron/*. Thiếu → route trả 500, không bao giờ cho qua.
CRON_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# ============================================================================
# 1.3 / 1.4 Watch & Alert
# ============================================================================

# Ký token hủy đăng ký trong email. Thiếu → mọi link hủy bị coi là không hợp lệ.
# Đổi giá trị này làm MỌI link hủy cũ mất hiệu lực.
UNSUBSCRIBE_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Web push — sinh bằng: pnpm exec web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:thong-bao@kairo.vn
