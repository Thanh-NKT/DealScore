# ============================================================================
# Supabase — lấy từ Supabase Dashboard > Project Settings > API
# ============================================================================

# URL project (an toàn để lộ ra client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key (an toàn để lộ ra client — RLS bảo vệ dữ liệu)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — CHỈ dùng ở server (collector, cron, admin).
# TUYỆT ĐỐI không prefix NEXT_PUBLIC_ và không dùng ở client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Tra cứu URL (1.1.a)
# ============================================================================

# Salt để hash IP cho rate limit. BẮT BUỘC ở production (thiếu thì /api/lookup lỗi).
LOOKUP_IP_SALT=chuoi-ngau-nhien-dai

# Trần ingest sản phẩm mới toàn hệ thống mỗi ngày (bảo vệ quota Shopee API).
# LOOKUP_DAILY_INGEST_CAP=2000

# Chỉ ở dev: dùng dữ liệu Shopee giả lập khi chưa có Open API. Bị bỏ qua ở production.
# Không đặt thì dán URL chưa có trong catalog sẽ báo "Chưa lấy được dữ liệu từ Shopee".
# SHOPEE_CLIENT=fake

# ============================================================================
# 1.6 Tài khoản
# ============================================================================

# URL gốc của site, dùng cho link trong email. Thiếu ở production → báo lỗi.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Resend — thiếu ở dev thì email ứng dụng được in ra console; thiếu ở production thì báo lỗi.
# RESEND_API_KEY=re_xxx
EMAIL_FROM="Kairo <thong-bao@kairo.vn>"

# Bảo vệ /api/cron/*. Thiếu → route trả 500, không bao giờ cho qua.
CRON_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# ============================================================================
# 1.3 / 1.4 Watch & Alert
# ============================================================================

# Ký token hủy đăng ký trong email. Thiếu → mọi link hủy bị coi là không hợp lệ.
# Đổi giá trị này làm MỌI link hủy cũ mất hiệu lực.
UNSUBSCRIBE_SECRET=doi-thanh-chuoi-ngau-nhien-dai

# Web push — sinh bằng: pnpm exec web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:thong-bao@kairo.vn

# ============================================================================
# 1.5 Affiliate — mọi giá trị dưới đây chờ spike Giai đoạn 0 (giả định G1–G6)
# ============================================================================

# Thiếu → /go đi link gốc, không có hoa hồng.
# SHOPEE_AFFILIATE_ID=
# an_redir (mặc định) | short_link (chỉ khi spike cho thấy an_redir không ghi nhận sub_id)
AFFILIATE_LINK_MODE=an_redir
# Thiếu → cron kéo đơn tự bỏ qua. Nhập tay bằng: pnpm conversions:import <file.csv>
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=
# SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.vn/graphql

# ============================================================================
# 1.10 Hạ tầng — giám sát & backup
# ============================================================================

# Sentry: không đặt thì không gửi gì (dev/preview).
# SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
# Chỉ cần khi muốn upload source map lúc build:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# pnpm db:backup — connection string Postgres (Dashboard > Connect > Session pooler).
# SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ============================================================================
# Giai đoạn 2 — Google login & Chrome extension
# ============================================================================

# Hiện nút "Tiếp tục với Google" (chỉ bật sau khi cấu hình Google OAuth trong Supabase).
# NEXT_PUBLIC_GOOGLE_AUTH=1
# Dùng trong supabase/config.toml ([auth.external.google]) khi chạy Supabase local.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Id của extension được gọi /api/extension/* (cách nhau bằng dấu phẩy). Không đặt: dev cho mọi extension
# unpacked, production từ chối tất cả.
# EXTENSION_IDS=
