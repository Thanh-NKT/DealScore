{
  "name": "kairo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "pnpm": ">=12",
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "seed:dev": "tsx --env-file=.env.local scripts/seed-dev.ts",
    "scores:recompute": "tsx --env-file=.env.local scripts/recompute-deal-scores.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "alerts:run": "tsx --conditions=react-server --env-file=.env.local scripts/run-alerts.ts",
    "conversions:import": "tsx --conditions=react-server --env-file=.env.local scripts/import-conversions.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "csv-parse": "^7.0.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
